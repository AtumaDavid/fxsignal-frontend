# Optional. Defaults: https://fxsignal.duckdns.org/api in production builds,
# http://localhost:4004/api in `npm run dev`.
# VITE_API_URL=http://localhost:4004/api
# Admin-only site: set to 1 on a second deployment (e.g. admin.example.com)
# to serve only /login + /admin. Add that origin to the API's FRONTEND_URL.
# VITE_ADMIN_ONLY=0
